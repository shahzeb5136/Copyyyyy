# Copy to backend/.env for local development. Never commit a real key.

# --- LLM (Microsoft Foundry, Claude deployment) ------------------------------------------------
LLM_PROVIDER=foundry
LLM_API_KEY=<your Foundry API key>
# Either the full Anthropic endpoint of your Foundry resource ...
LLM_BASE_URL=https://<your-resource>.services.ai.azure.com/anthropic/
# ... or just the resource name (one of the two is enough)
# LLM_FOUNDRY_RESOURCE=<your-resource>
LLM_MODEL=claude-opus-5-5

# --- LLM (Azure OpenAI / OpenAI-family deployment on Foundry) -----------------------------------
# LLM_PROVIDER=azure_openai
# LLM_API_KEY=<key>
# LLM_BASE_URL=https://<your-resource>.openai.azure.com/
# LLM_MODEL=<deployment name>
# LLM_API_VERSION=2024-10-21

# --- No LLM at all (heuristics only; fine for UI development) -----------------------------------
# LLM_PROVIDER=mock

# --- Behaviour ------------------------------------------------------------------------------------
LLM_SAMPLE_ROWS=5             # sample rows sent to the model
LLM_MAX_DISTINCT_VALUES=100   # top distinct text values per column sent to the model
LLM_TIMEOUT_SECONDS=180
LLM_LOG_PROMPTS=false         # true logs full prompts/responses (contain data samples) - dev only

# --- Storage ---------------------------------------------------------------------------------------
STORAGE_MODE=local            # local | blob
STORAGE_LOCAL_DIR=.data
# BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net   (managed identity)
# BLOB_CONTAINER=dashboard-builder
RETENTION_HOURS=72

# --- Limits ---------------------------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_ROWS=1000000
MAX_CHART_ROWS=5000
LOG_LEVEL=INFO
REQUIRE_EASY_AUTH=false       # true in production behind Easy Auth
