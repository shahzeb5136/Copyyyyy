# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Streamlit Community Cloud, paste the same content into  App settings → Secrets.
# Every option can also be set with an environment variable (shown in brackets).

[app]
title = "Ask Your Data"                                   # [APP_TITLE]
tagline = "Ask questions in plain English. AI writes the SQL, reads the results and picks the chart."
organization = "Your Company"                             # shown in the sidebar footer
organization_url = "https://www.example.com"
repo_url = "https://github.com/shahzeb5136/structured_data_llms_querying" # adds a "Source on GitHub" link

[llm]
provider = "anthropic"            # "anthropic" | "openai" | "offline"   [LLM_PROVIDER]
model = "claude-sonnet-5-5"       # default model                        [LLM_MODEL]
anthropic_api_key = "sk-ant-..."  #                                      [ANTHROPIC_API_KEY]
openai_api_key = ""               #                                      [OPENAI_API_KEY]
allow_user_api_keys = true        # visitors may paste their own key when no server key is set
allow_model_choice = true         # show the provider/model picker in the sidebar
effort = ""                       # Anthropic only, optional: "low" | "medium" | "high"

[limits]
max_questions_per_session = 25    # 0 = unlimited; protects your API budget on a public demo
max_result_rows = 5000
query_timeout_seconds = 15
max_upload_rows = 500000

[access]
# "none"     - open to everyone
# "password" - username/password from [access.users] (default when users are listed)
# "oidc"     - Google / Microsoft / Okta sign-in via Streamlit's native st.login (configure [auth] below)
mode = "password"
show_demo_credentials = true      # print the first user's credentials on the login screen

[access.users]
demo = "demo"
# Store hashed passwords instead of plain text:
#   python -c "import hashlib; print('sha256:' + hashlib.sha256(b'my-password').hexdigest())"
# alice = "sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"

# Optional allow-lists for mode = "oidc"
# allowed_domains = ["example.com"]
# allowed_emails = ["someone@gmail.com"]

# --- Streamlit native authentication (only for mode = "oidc") -----------------
# [auth]
# redirect_uri = "https://your-app.streamlit.app/oauth2callback"
# cookie_secret = "a-long-random-string"
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
